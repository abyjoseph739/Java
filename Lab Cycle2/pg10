class Student {

    String name;
    int rollNo;

    Student(String name, int rollNo) {
        this.name = name;
        this.rollNo = rollNo;
    }
}

class Demo {

    void display(Student s) {
        System.out.println("Student Name : " + s.name);
        System.out.println("Roll No : " + s.rollNo);
    }
}

public class Main10 {
    public static void main(String[] args) {

        Student s = new Student("Neha", 25);

        Demo d = new Demo();

        d.display(s);   

    }
}